# Public site URL used for canonical / JSON-LD / sitemap
SITE_URL=http://localhost:3000
# ?simulate=slow|error|empty demo switch on APIs; set to 0 to disable
DEMO_SIMULATE=1
# Action center summary. Without a key the Generate button returns the rule-based template summary.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=  # optional; defaults to DEFAULT_MODEL in llm/claude.ts
# anthropic (default) | mock — mock returns a fixed demo summary with one deliberately wrong number
LLM_PROVIDER=anthropic
