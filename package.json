{
  "name": "geo-fe",
  "private": true,
  "packageManager": "pnpm@7.33.7",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "seed": "pnpm --filter @geo/backend db:seed",
    "dev": "pnpm seed && pnpm --filter frontend dev",
    "build": "pnpm seed && pnpm --filter frontend build",
    "demo": "pnpm build && pnpm --filter frontend start",
    "test": "pnpm --filter @geo/backend test && pnpm --filter frontend test",
    "typecheck": "pnpm --filter frontend exec tsc --noEmit && pnpm --filter @geo/backend exec tsc --noEmit -p .",
    "lint": "pnpm --filter frontend lint",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@ant-design/nextjs-registry": "^1.3.0",
    "antd": "^6.6.8",
    "dayjs": "^1.11.23"
  }
}
