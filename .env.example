# Public site origin for canonical / JSON-LD / sitemap / robots / llms.txt.
# Origin only (https://example.com, no path). Unset → http://localhost:3000; a malformed value fails the build.
SITE_URL=http://localhost:3000
# ?simulate=slow|error|empty demo switch on APIs; set to 0 to disable
DEMO_SIMULATE=1
# ── Action center · executive summary ───────────────────────────────────────────────────────────────────────────
# Three modes, picked by LLM_PROVIDER and the keys below. Without any key the Generate button returns the
# deterministic rule-based template summary, so the app runs fully without configuration.
#
# 1) No key (default)        → rule-based template summary (badge: Rules). Nothing to configure.
# 2) LLM_PROVIDER=mock       → fixed demo summary with one deliberately wrong number (badge: Mock LLM (demo)),
#                              keys are ignored. No network.
# 3) Real provider           → two backends, both share the same 15 s timeout and template fallback:
#    • Anthropic Claude:     ANTHROPIC_API_KEY (+ optional ANTHROPIC_MODEL, default in llm/claude.ts)
#    • OpenAI-compatible:    LLM_API_KEY + LLM_BASE_URL + LLM_MODEL against a /chat/completions endpoint
#                             (DeepSeek, Qwen, OpenAI, a local gateway…; names match the brand-writer adapter,
#                              so its .env can be copied over)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=  # optional; defaults to DEFAULT_MODEL in llm/claude.ts

# Any OpenAI-compatible endpoint. Used by provider "openai" and by auto-detection when LLM_PROVIDER is unset.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# Explicit selection: anthropic | mock | openai. When unset, the backend auto-detects from the keys present:
# ANTHROPIC_API_KEY → anthropic (also when BOTH keys are set); only LLM_API_KEY → openai; neither key → template.
LLM_PROVIDER=anthropic
